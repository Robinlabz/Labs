# Copy to .env and fill in. .env is gitignored — never commit real values.
# Everything here can also be passed as a --flag on the command line.

# Your main wallet — where everything gets swept TO. REQUIRED.
DEST=0xYourMainWalletHere

# Token contract address (CA) to sweep. One token.
TOKENS=0xTokenCAHere

# Dedicated funder wallet that pays the gas to fund the bot wallets.
# REQUIRED for the fund phase. Keep it separate from your main wallet.
# (Or use --funder-keyfile /path/to/keyfile instead of putting it here.)
FUNDER_KEY=0xFunderPrivateKeyHere

# Where the bot-wallet keys live (dir or file). Auto-detects the format.
KEYS=/root/robin-dist/robin-distributor-contract/

# Chain — defaults are Robinhood Chain; only change if you know why.
RPC_URL=https://your-paid-rpc-endpoint
CHAIN_ID=4663

# Multicall3 batches the balance scan (big speedup at thousands of wallets).
# It's deployed + verified on Robinhood Chain at the canonical address below,
# and the script uses it BY DEFAULT — you don't need to set this. Override only
# to point at a different address, or pass --no-multicall to read per-wallet.
# MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# Optional tuning.
# PHASES=fund,collect,refund     # or a subset, in order
# CONCURRENCY=5                  # collect/refund wallets in flight
# DELAY_MS=120                   # pause between sends/reads
# GAS_BUFFER_MULT=1.25           # funding headroom on gas estimates
# MIN_TOKEN=0                    # ignore holders below this many tokens
# LOG_FILE=sweep-audit.jsonl     # append-only record of every send

# Optional: only if a seed phrase is found instead of individual keys.
# MNEMONIC_COUNT=50
# DERIVE_PATH=m/44'/60'/0'/0

# Optional: password for v3 keystore files, if that's how keys are stored.
# KEYSTORE_PASSWORD=
