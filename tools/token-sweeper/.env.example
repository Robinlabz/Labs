# Copy to .env and fill in. .env is gitignored — never commit real values.
# Everything here can also be passed as a --flag on the command line.

# Your main wallet — where everything gets swept TO. REQUIRED.
DEST=0xYourMainWalletHere

# Where the bot-wallet keys live (dir or file). Auto-detects the format.
KEYS=/root/robin-dist/robin-distributor-contract/

# Chain — defaults are Robinhood Chain; only change if you know why.
RPC_URL=https://robinhoodchain.blockscout.com/api/eth-rpc
CHAIN_ID=4663

# Optional: comma-separated token CAs (or pass --token on the CLI instead).
# TOKENS=0xToken1,0xToken2

# Optional: only if a seed phrase is found instead of individual keys.
# MNEMONIC_COUNT=50
# DERIVE_PATH=m/44'/60'/0'/0

# Optional: password for v3 keystore files, if that's how keys are stored.
# KEYSTORE_PASSWORD=
